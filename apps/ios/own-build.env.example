# Settings for own-build.sh: copy to ~/.config/codync/own-build.env (or point OWN_BUILD_SETTINGS at your copy).
# Kept outside the repository; holds ids only, never a key.

# Your app's bundle id; its extensions and App Group are derived from it.
OWN_IOS_BUNDLE_ID=com.example.codync
# The name under the icon.
OWN_IOS_APP_NAME="Codync Own"
# Your Apple team id (developer.apple.com → Membership details); needed to upload.
OWN_IOS_TEAM=ABCDE12345
# The command that runs the xcodebuild command it's given with your App Store Connect key's options added. It alone
# holds the key (README.md).
OWN_IOS_SIGNER=/usr/local/libexec/codync-asc-xcodebuild
# The branch `own-build.sh follow` ships (remote/branch).
OWN_IOS_FOLLOW=origin/dev
